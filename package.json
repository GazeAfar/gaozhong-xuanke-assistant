{
  "name": "gaozhong-xuanke-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "高中选科助手 - 微信小程序与纯函数选科推荐引擎",
  "scripts": {
    "build:packages": "tsc -p packages/contracts/tsconfig.json && tsc -p packages/rules-engine/tsconfig.json",
    "sync:miniprogram": "node scripts/sync-miniprogram.mjs",
    "typecheck:miniprogram": "tsc -p tsconfig.miniprogram.json --noEmit",
    "typecheck": "npm run build:packages && npm run sync:miniprogram && npm run typecheck:miniprogram",
    "test:engine": "node --test tests/engine.test.mjs",
    "test:data": "node --test tests/data-validation.test.mjs",
    "test:api": "node --test tests/server.test.mjs",
    "test": "npm run build:packages && node --test tests",
    "start:server": "node server/index.mjs",
    "import:xlsx": "python scripts/import-official-xlsx.py",
    "import:csv": "node scripts/import-official-csv.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "diff:data": "node scripts/preview-diff.mjs"
  },
  "devDependencies": {
    "miniprogram-api-typings": "^4.1.0",
    "typescript": "^5.7.3"
  }
}
