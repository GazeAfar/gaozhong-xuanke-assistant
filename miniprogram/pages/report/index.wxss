.summary-card {
  margin-bottom: 24rpx;
}

.summary-meta {
  font-size: max(36rpx, 18px);
  font-weight: 600;
  color: #172033;
  margin-bottom: 8rpx;
}

.snapshot-toggle {
  margin-top: 16rpx;
  color: #2457D6;
  font-size: max(28rpx, 14px);
  font-weight: 500;
}

.snapshot-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.snapshot-item {
  width: calc(50% - 6rpx);
  background-color: #FFFFFF;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  display: flex;
  justify-content: space-between;
  font-size: max(26rpx, 13px);
}

.snapshot-subj {
  color: #172033;
  font-weight: 500;
}

.snapshot-val {
  color: #2457D6;
}

.section-heading {
  font-size: max(34rpx, 17px);
  font-weight: 600;
  color: #172033;
  margin: 24rpx 0 16rpx;
}

.expand-link {
  color: #2457D6;
  font-size: max(28rpx, 14px);
  font-weight: 600;
  padding: 8rpx 12rpx;
}

.missing-box {
  margin: 16rpx 0 24rpx;
  padding: 16rpx 20rpx;
  background-color: #F8FAFC;
  border-radius: 14rpx;
}

.missing-list {
  font-weight: 600;
  color: #172033;
}

.btn-stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.action-mt {
  margin-top: 24rpx;
}

.method-footer {
  padding: 24rpx 32rpx;
}

.method-link {
  margin-top: 12rpx;
  color: #2457D6;
  font-size: max(28rpx, 14px);
  font-weight: 500;
}
