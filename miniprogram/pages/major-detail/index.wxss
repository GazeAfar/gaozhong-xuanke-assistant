.school-meta {
  font-size: max(30rpx, 15px);
  color: #4B5563;
  margin: 10rpx 0 8rpx;
}

.raw-box {
  background-color: #F8FAFC;
  border-radius: 14rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.std-row {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 14rpx 0;
  border-top: 1rpx solid #E5EAF2;
}

.std-label {
  font-size: max(26rpx, 13px);
  color: #4B5563;
}

.std-val {
  font-size: max(30rpx, 15px);
  color: #172033;
  font-weight: 500;
}

.combo-sub {
  margin-bottom: 14rpx;
}

.disclaimer {
  margin-top: 16rpx;
}

.feedback-btn {
  margin-top: 20rpx;
}
