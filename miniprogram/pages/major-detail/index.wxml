<view class="page-container">
  <empty-state
    wx:if="{{notFound}}"
    title="未找到该专业条目"
    description="条目可能已更新或移除，请返回专业列表重新查询。"
    actionText="返回列表"
    bind:action="onBack"
  />

  <block wx:elif="{{offering && dataset}}">
    <view class="notice-warning" wx:if="{{dataset.isDemo}}">
      {{dataset.scopeNote}}
    </view>

    <!-- 1. 专业名称、院校与层次 -->
    <view class="card">
      <view class="page-title">{{offering.majorName}}</view>
      <view class="school-meta">
        {{offering.institutionName}} · {{offering.level}} · {{dataset.dataYear}} 年资料
      </view>
      <view class="source-text" wx:if="{{offering.majorCode}}">
        专业代码：{{offering.majorCode}} · 资料类型：选考科目要求（非当年招生计划）
      </view>
    </view>

    <!-- 2. 选科条件原文与标准化解释 -->
    <view class="card">
      <view class="card-title">选科要求说明</view>
      <view class="raw-box">
        <text class="source-text">条件原文：</text>
        <text class="body-text">{{offering.requirementRaw}}</text>
      </view>

      <view class="std-row">
        <text class="std-label">首选科目</text>
        <text class="std-val">{{firstSubjectText}}</text>
      </view>
      <view class="std-row">
        <text class="std-label">再选科目</text>
        <text class="std-val">{{reselectText}}</text>
      </view>
    </view>

    <!-- 3. 当前组合条件状态 -->
    <view class="card" wx:if="{{matchStatus}}">
      <view class="card-title">当前组合匹配情况</view>
      <view class="secondary-text combo-sub">当前查看组合：{{combinationName}}</view>
      <requirement-badge status="{{matchStatus}}" />
      <view class="source-text disclaimer">
        说明：满足已知选科条件仅代表选考科目符合这条资料要求，不代表分数线、体检、性别或当年招生计划等其他条件均满足。
      </view>
    </view>

    <!-- 4. 来源与日期 -->
    <view class="card">
      <view class="card-title">参考资料来源</view>
      <source-block wx:for="{{sources}}" wx:key="id" source="{{item}}" />
    </view>

    <!-- 5. 纠错入口 -->
    <view class="card">
      <view class="card-title">发现这条资料有误？</view>
      <view class="secondary-text">如果你发现选科要求原文或解释与官方公告不一致，可以提交纠错说明。</view>
      <button class="btn-secondary feedback-btn" bindtap="onGoFeedback">提交这条资料的纠错</button>
    </view>
  </block>
</view>
