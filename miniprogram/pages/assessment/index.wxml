<view class="page-with-footer">
  <!-- 1. 地区与高考年份 -->
  <view class="card">
    <view class="card-title">地区与预计高考年份</view>
    <view class="picker-grid">
      <picker
        class="picker-box"
        mode="selector"
        range="{{provinceOptions}}"
        range-key="name"
        value="{{provinceIndex}}"
        bindchange="onProvinceChange"
      >
        <text class="source-text">省份</text>
        <view class="picker-val">
          <text>{{provinceOptions[provinceIndex].name}}</text>
          <text class="picker-arrow">▾</text>
        </view>
      </picker>

      <picker
        class="picker-box"
        mode="selector"
        range="{{examYearOptions}}"
        range-key="label"
        value="{{examYearIndex}}"
        bindchange="onYearChange"
      >
        <text class="source-text">预计高考年份</text>
        <view class="picker-val">
          <text>{{examYearOptions[examYearIndex].label}}</text>
          <text class="picker-arrow">▾</text>
        </view>
      </picker>
    </view>

    <view class="notice-warning unsupported-box" wx:if="{{!provinceSupported}}">
      <view>这个地区还在准备中。为了不套用外省选科规则，当前暂不提供测算。</view>
      <view class="unsupported-actions">
        <button class="btn-secondary small-btn" bindtap="onBackHome">返回首页</button>
        <button class="btn-ghost small-btn" bindtap="onGoAbout">查看说明</button>
      </view>
    </view>

    <view class="notice-warning ref-box" wx:if="{{provinceSupported && needsReferenceChoice}}">
      <view>目标为 {{examYearOptions[examYearIndex].label}}，当前专业条件仅收录 2027 年参考资料。</view>
      <view class="ref-choices">
        <view
          class="choice-pill {{useReferenceData ? 'choice-active' : ''}}"
          data-use="true"
          bindtap="onToggleReferenceData"
        >查看 2027 年参考资料</view>
        <view
          class="choice-pill {{!useReferenceData ? 'choice-active' : ''}}"
          data-use="false"
          bindtap="onToggleReferenceData"
        >仅比较科目组合</view>
      </view>
    </view>
  </view>

  <block wx:if="{{provinceSupported}}">
    <!-- 2. 六科优势自评 -->
    <view class="card">
      <view class="row-between">
        <text class="card-title">六科学习优势</text>
        <text class="progress-text">已作答 {{answeredAdvantageCount}} / 6</text>
      </view>
      <view class="secondary-text section-desc">
        每科选择当前更贴近的感受；拿不准可选「还不了解」，不会当作差科。
      </view>

      <rating-selector
        wx:for="{{subjectList}}"
        wx:key="code"
        subjectCode="{{item.code}}"
        subjectName="{{item.name}}"
        mode="advantage"
        value="{{advantage[item.code]}}"
        hasError="{{errorSubject === item.code}}"
        bind:change="onAdvantageChange"
      />
    </view>

    <!-- 3. 学科兴趣（可跳过） -->
    <view class="card">
      <view class="row-between">
        <view>
          <text class="card-title">学科兴趣</text>
          <text class="tag tag-primary optional-tag">可跳过</text>
        </view>
        <view class="toggle-link" bindtap="onToggleInterestSection">
          {{interestEnabled ? '撤销此项' : '展开填写'}}
        </view>
      </view>
      <view class="secondary-text">
        {{interestEnabled ? '六科全部填写后会与学习优势一起参与排序；仅填部分时保留在理由中展示。' : '如果不填写，本次将仅按学习优势整理候选组合。'}}
      </view>

      <view wx:if="{{interestEnabled}}" class="interest-list">
        <rating-selector
          wx:for="{{subjectList}}"
          wx:key="code"
          subjectCode="{{item.code}}"
          subjectName="{{item.name}}"
          mode="interest"
          value="{{interest[item.code]}}"
          bind:change="onInterestChange"
        />
      </view>
    </view>

    <!-- 4. 专业意向（可跳过） -->
    <view class="card">
      <view class="row-between">
        <view>
          <text class="card-title">专业意向</text>
          <text class="tag tag-primary optional-tag">可跳过 · 最多 3 个</text>
        </view>
      </view>
      <view class="secondary-text section-desc">
        选择后会在报告中联动云端已发布的官方选科库展示匹配情况；若尚未接入正式库，仅记录为讨论方向。
      </view>

      <view class="major-chips">
        <view
          class="major-chip {{noMajorDirection ? 'major-chip-active' : ''}}"
          bindtap="onSelectNoMajor"
        >
          {{noMajorDirection ? '✓ ' : ''}}还没有方向
        </view>
        <view
          wx:for="{{majorCatalog}}"
          wx:key="id"
          class="major-chip {{preferredMajorIds.indexOf(item.id) >= 0 ? 'major-chip-active' : ''}}"
          data-id="{{item.id}}"
          bindtap="onToggleMajor"
        >
          {{preferredMajorIds.indexOf(item.id) >= 0 ? '✓ ' : ''}}{{item.name}}
        </view>
      </view>

      <view class="preserve-row" wx:if="{{preferredMajorIds.length > 0}}">
        <view class="preserve-info">
          <text class="body-text">希望保留这些方向</text>
          <text class="source-text">仅在目标年已核实且资料完整时用于筛选，资料不足时自动转为提示</text>
        </view>
        <switch checked="{{preserveMajors}}" color="#2457D6" bindchange="onTogglePreserveMajors" />
      </view>
    </view>

    <!-- 5. 更多条件：学校开班组合限制 -->
    <view class="card">
      <view class="row-between" bindtap="onToggleSchoolSection">
        <view>
          <text class="card-title">更多条件：学校开班限制</text>
          <text class="tag tag-primary optional-tag">可跳过</text>
        </view>
        <text class="toggle-link">{{schoolSectionOpen ? '收起' : '展开'}}</text>
      </view>
      <view class="secondary-text">默认允许全部 12 种组合；如果学校只开设部分组合，可在此勾选。</view>

      <view wx:if="{{schoolSectionOpen}}" class="school-panel">
        <view class="preserve-row">
          <text class="body-text">按学校实际开班组合筛选</text>
          <switch checked="{{schoolRestrictionEnabled}}" color="#2457D6" bindchange="onToggleSchoolRestriction" />
        </view>

        <view wx:if="{{schoolRestrictionEnabled}}" class="combo-grid">
          <view
            wx:for="{{allCombinations}}"
            wx:key="id"
            class="combo-toggle {{allowedCombinationIds.indexOf(item.id) >= 0 ? 'combo-toggle-active' : ''}}"
            data-id="{{item.id}}"
            bindtap="onToggleAllowedCombo"
          >
            {{allowedCombinationIds.indexOf(item.id) >= 0 ? '✓ ' : ''}}{{item.displayName}}
          </view>
        </view>
      </view>
    </view>
  </block>
</view>

<view class="fixed-footer" wx:if="{{provinceSupported}}">
  <button
    class="btn-primary {{submitting ? 'btn-primary-disabled' : ''}}"
    disabled="{{submitting}}"
    bindtap="onSubmit"
  >
    {{submitting ? '正在整理建议...' : '查看建议'}}
  </button>
</view>
