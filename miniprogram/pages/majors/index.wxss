.search-card {
  padding: 28rpx;
}

.meta-row {
  margin-bottom: 20rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background-color: #F6F7FB;
  border: 2rpx solid #D7DEEA;
  border-radius: 16rpx;
  padding: 0 24rpx;
  min-height: 88rpx;
}

.search-input {
  flex: 1;
  font-size: max(30rpx, 15px);
  color: #172033;
  height: 80rpx;
}

.clear-btn {
  color: #2457D6;
  font-size: max(28rpx, 14px);
  padding: 12rpx;
}

.filter-row {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #E5EAF2;
}

.filter-val {
  color: #2457D6;
  font-size: max(28rpx, 14px);
  font-weight: 500;
}

.loading-hint {
  text-align: center;
  color: #4B5563;
  padding: 40rpx 0;
}

.offering-card {
  padding: 28rpx 32rpx;
}

.offering-major {
  font-size: max(34rpx, 17px);
  font-weight: 600;
  color: #172033;
}

.offering-school {
  font-size: max(28rpx, 14px);
  color: #4B5563;
  margin-top: 6rpx;
}

.offering-req {
  font-size: max(30rpx, 15px);
  color: #172033;
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  background-color: #F8FAFC;
  border-radius: 12rpx;
}

.offering-footer {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.detail-link {
  color: #2457D6;
  font-size: max(28rpx, 14px);
  font-weight: 500;
  flex-shrink: 0;
}

.unavailable-desc {
  margin-bottom: 20rpx;
}

.official-box {
  background-color: #F8FAFC;
  border: 1rpx solid #D7DEEA;
  border-radius: 14rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}

.official-url {
  font-size: max(28rpx, 14px);
  color: #2457D6;
  word-break: break-all;
  margin-top: 8rpx;
  font-weight: 500;
}

.unavailable-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
