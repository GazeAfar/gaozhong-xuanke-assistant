.dim-title {
  font-size: max(32rpx, 16px);
  font-weight: 600;
  color: #172033;
  margin: 28rpx 0 16rpx;
}

.dim-title:first-child {
  margin-top: 0;
}

.compare-row {
  display: flex;
  gap: 16rpx;
  align-items: stretch;
}

.narrow-card {
  flex: 1;
  min-width: 0;
  background-color: #FFFFFF;
  border: 1rpx solid #D7DEEA;
  border-radius: 20rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.narrow-title {
  font-size: max(30rpx, 15px);
  font-weight: 600;
  color: #172033;
  line-height: 1.4;
}

.remove-link {
  color: #2457D6;
  font-size: max(26rpx, 13px);
  padding-top: 8rpx;
}

.dim-line {
  font-size: max(26rpx, 13px);
  color: #172033;
  line-height: 1.5;
  word-break: break-word;
}

.dim-strong {
  font-weight: 600;
  color: #2457D6;
}
