.hero-card {
  background-color: #EDF2FF;
  border: 1rpx solid #D5E2FF;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.brand-badge {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background-color: #2457D6;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.brand-info {
  display: flex;
  flex-direction: column;
}

.brand-name {
  font-size: max(32rpx, 16px);
  font-weight: 600;
  color: #172033;
}

.brand-sub {
  font-size: max(26rpx, 13px);
  color: #4B5563;
}

.hero-headline {
  margin-bottom: 12rpx;
}

.hero-desc {
  font-size: max(30rpx, 15px);
  color: #4B5563;
  margin-bottom: 32rpx;
}

.hero-cta {
  margin-top: 8rpx;
}

.restart-row {
  margin-top: 12rpx;
  text-align: center;
}

.region-card {
  display: flex;
  align-items: stretch;
  padding: 28rpx 32rpx;
}

.region-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.region-divider {
  width: 1rpx;
  background-color: #D7DEEA;
  margin: 0 24rpx;
}

.region-value {
  font-size: max(36rpx, 18px);
  font-weight: 600;
  color: #172033;
}

.region-picker-val {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.picker-arrow {
  color: #2457D6;
  font-size: 28rpx;
}

.highlights-card {
  padding: 28rpx 32rpx;
}

.highlight-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.highlight-item:last-child {
  margin-bottom: 0;
}

.highlight-check {
  color: #2457D6;
  font-weight: 700;
  font-size: 32rpx;
  line-height: 1.5;
}

.highlight-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
}

.quick-links {
  padding: 8rpx 32rpx;
}

.quick-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  min-height: 96rpx;
}

.quick-title {
  font-weight: 500;
}

.quick-arrow {
  font-size: 40rpx;
  color: #4B5563;
  padding-left: 16rpx;
}

.quick-divider {
  height: 1rpx;
  background-color: #E5EAF2;
}

.retry-link {
  margin-top: 12rpx;
  color: #2457D6;
  font-weight: 600;
}
