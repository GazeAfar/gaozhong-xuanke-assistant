.req-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-size: max(26rpx, 13px);
  line-height: 1.4;
  font-weight: 500;
}

.req-eligible {
  background-color: #ECFDF3;
  color: #166534;
}

.req-ineligible {
  background-color: #FEF3F2;
  color: #B42318;
}

.req-unknown {
  background-color: #FEF9E7;
  color: #92400E;
}

.req-icon {
  font-weight: 700;
}
