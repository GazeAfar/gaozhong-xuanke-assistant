<view class="combo-card {{highlightFirst ? 'combo-card-highlight' : ''}}">
  <view class="combo-top">
    <view class="combo-name-wrap">
      <text class="combo-name">{{item.displayName}}</text>
      <view class="badge-row">
        <text class="badge badge-primary" wx:if="{{item.state === 'ranked' && item.label === '优先看看'}}">{{item.label}}</text>
        <text class="badge badge-neutral" wx:elif="{{item.state === 'ranked'}}">{{item.label}}</text>
        <text class="badge badge-warning" wx:elif="{{item.state === 'needs_input'}}">信息待补充</text>
        <text class="badge badge-muted" wx:elif="{{item.state === 'excluded'}}">已按条件排除</text>

        <text class="tie-hint" wx:if="{{item.isTiedWithPrevious}}">和前一组差异不明显</text>
      </view>
    </view>

    <view
      wx:if="{{showCompareButton && item.state !== 'excluded'}}"
      class="compare-chip {{selectedForCompare ? 'compare-chip-active' : ''}}"
      bindtap="onToggleCompare"
    >
      <text>{{selectedForCompare ? '✓ 已加入比较' : '+ 加入比较'}}</text>
    </view>
  </view>

  <view class="reasons-block" wx:if="{{item.reasons && item.reasons.length > 0}}">
    <view class="reason-item" wx:for="{{item.reasons}}" wx:key="*this" wx:for-item="reason">
      <text class="reason-dot">•</text>
      <text class="reason-text">{{reason}}</text>
    </view>
  </view>

  <view class="excluded-block" wx:if="{{item.state === 'excluded' && item.excludedReasons && item.excludedReasons.length > 0}}">
    <text class="excluded-title">排除原因：</text>
    <text class="excluded-text" wx:for="{{item.excludedReasons}}" wx:key="*this" wx:for-item="ex">{{ex}}</text>
  </view>

  <view class="attention-block" wx:if="{{item.attentionNote}}">
    <text class="attention-label">需要关注：</text>
    <text class="attention-text">{{item.attentionNote}}</text>
  </view>

  <view class="major-block" wx:if="{{item.majorStatuses && item.majorStatuses.length > 0}}">
    <view class="major-row" wx:for="{{item.majorStatuses}}" wx:key="majorId" wx:for-item="ms">
      <text class="major-name">{{ms.majorName}}</text>
      <text class="major-status status-{{ms.status}}">{{ms.summaryText}}</text>
    </view>
  </view>
</view>
