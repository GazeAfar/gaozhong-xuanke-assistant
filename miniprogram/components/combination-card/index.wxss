.combo-card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  border: 1rpx solid #D7DEEA;
  margin-bottom: 24rpx;
}

.combo-card-highlight {
  border: 2rpx solid #2457D6;
  background-color: #FAFBFD;
}

.combo-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.combo-name-wrap {
  flex: 1;
}

.combo-name {
  font-size: max(38rpx, 19px);
  font-weight: 600;
  color: #172033;
  line-height: 1.4;
  display: block;
}

.badge-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.badge {
  font-size: max(26rpx, 13px);
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  line-height: 1.4;
}

.badge-primary {
  background-color: #EDF2FF;
  color: #2457D6;
  font-weight: 500;
}

.badge-neutral {
  background-color: #F1F5F9;
  color: #334155;
}

.badge-warning {
  background-color: #FEF9E7;
  color: #92400E;
}

.badge-muted {
  background-color: #F3F4F6;
  color: #4B5563;
}

.tie-hint {
  font-size: max(26rpx, 13px);
  color: #4B5563;
}

.compare-chip {
  flex-shrink: 0;
  min-height: 72rpx;
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  border: 2rpx solid #2457D6;
  color: #2457D6;
  font-size: max(28rpx, 14px);
  display: inline-flex;
  align-items: center;
  background-color: #FFFFFF;
}

.compare-chip-active {
  background-color: #2457D6;
  color: #FFFFFF;
}

.reasons-block {
  margin-top: 20rpx;
}

.reason-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.reason-dot {
  color: #2457D6;
  font-weight: 700;
}

.reason-text {
  font-size: max(30rpx, 15px);
  line-height: 1.55;
  color: #172033;
  flex: 1;
}

.attention-block {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background-color: #FEF9E7;
  font-size: max(28rpx, 14px);
  line-height: 1.55;
  color: #92400E;
}

.attention-label {
  font-weight: 600;
}

.excluded-block {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background-color: #F3F4F6;
  font-size: max(28rpx, 14px);
  color: #4B5563;
}

.excluded-title {
  font-weight: 600;
  margin-right: 8rpx;
}

.major-block {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #E5EAF2;
}

.major-row {
  display: flex;
  flex-direction: column;
  margin-bottom: 10rpx;
}

.major-name {
  font-size: max(28rpx, 14px);
  font-weight: 600;
  color: #172033;
}

.major-status {
  font-size: max(26rpx, 13px);
  margin-top: 4rpx;
}

.status-eligible {
  color: #166534;
}

.status-ineligible {
  color: #B42318;
}

.status-unknown {
  color: #92400E;
}
