.source-box {
  background-color: #F8FAFC;
  border: 1rpx solid #D7DEEA;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.source-title {
  font-size: max(28rpx, 14px);
  font-weight: 600;
  color: #172033;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.source-meta {
  font-size: max(26rpx, 13px);
  color: #4B5563;
  line-height: 1.5;
}

.source-note {
  font-size: max(26rpx, 13px);
  color: #4B5563;
  line-height: 1.55;
  margin-top: 8rpx;
}

.copy-btn {
  margin-top: 16rpx;
  display: inline-flex;
  align-items: center;
  min-height: 72rpx;
  padding: 10rpx 24rpx;
  border-radius: 12rpx;
  border: 2rpx solid #2457D6;
  color: #2457D6;
  font-size: max(26rpx, 13px);
  background-color: #FFFFFF;
}
