<view class="selector {{hasError ? 'selector-error' : ''}}" id="subject-{{subjectCode}}">
  <view class="selector-header">
    <text class="subject-name">{{subjectName}}</text>
    <text class="status-hint" wx:if="{{hasError}}">请先选择一项</text>
    <text class="status-selected" wx:elif="{{value === null}}">已选：还不了解</text>
    <text class="status-selected" wx:elif="{{value >= 1 && value <= 5}}">已选：{{options[value - 1].label}}</text>
    <text class="status-unanswered" wx:else>未填写</text>
  </view>

  <view class="options-grid" role="radiogroup" aria-label="{{subjectName}}">
    <view
      wx:for="{{options}}"
      wx:key="score"
      class="option-btn {{value === item.score ? 'option-active' : ''}}"
      data-score="{{item.score}}"
      bindtap="onSelectScore"
      role="radio"
      aria-checked="{{value === item.score}}"
      aria-label="{{subjectName}} {{item.label}}"
    >
      <text class="option-check" wx:if="{{value === item.score}}">✓ </text>
      <text class="option-label">{{item.label}}</text>
    </view>
  </view>

  <view class="unknown-row">
    <view
      class="unknown-btn {{value === null ? 'unknown-active' : ''}}"
      bindtap="onSelectUnknown"
      role="radio"
      aria-checked="{{value === null}}"
      aria-label="{{subjectName}} 还不了解"
    >
      <text wx:if="{{value === null}}">✓ </text>
      <text>还不了解</text>
    </view>
  </view>
</view>
