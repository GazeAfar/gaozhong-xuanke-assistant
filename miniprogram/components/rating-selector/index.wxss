.selector {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #E5EAF2;
}

.selector:last-child {
  border-bottom: none;
}

.selector-error {
  background-color: #FEF3F2;
  border: 2rpx solid #B42318;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.selector-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.subject-name {
  font-size: max(34rpx, 17px);
  font-weight: 600;
  color: #172033;
}

.status-hint {
  font-size: max(26rpx, 13px);
  color: #B42318;
  font-weight: 500;
}

.status-selected {
  font-size: max(26rpx, 13px);
  color: #2457D6;
}

.status-unanswered {
  font-size: max(26rpx, 13px);
  color: #4B5563;
}

.options-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.option-btn {
  min-height: 80rpx;
  padding: 14rpx 22rpx;
  border-radius: 16rpx;
  border: 2rpx solid #D7DEEA;
  background-color: #FFFFFF;
  color: #172033;
  font-size: max(28rpx, 14px);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: all 150ms ease;
}

.option-active {
  background-color: #EDF2FF;
  border-color: #2457D6;
  color: #2457D6;
  font-weight: 600;
}

.option-check {
  color: #2457D6;
  font-weight: 700;
}

.unknown-row {
  margin-top: 16rpx;
}

.unknown-btn {
  display: inline-flex;
  align-items: center;
  min-height: 72rpx;
  padding: 10rpx 24rpx;
  border-radius: 16rpx;
  border: 2rpx dashed #CBD5E1;
  color: #4B5563;
  font-size: max(28rpx, 14px);
  background-color: #F8FAFC;
}

.unknown-active {
  background-color: #EDF2FF;
  border-style: solid;
  border-color: #2457D6;
  color: #2457D6;
  font-weight: 600;
}
