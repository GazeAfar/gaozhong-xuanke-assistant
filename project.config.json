{
  "description": "高中选科助手小程序项目配置",
  "packOptions": {
    "ignore": [
      { "value": "docs", "type": "folder" },
      { "value": "prototype", "type": "folder" },
      { "value": "data", "type": "folder" },
      { "value": "server", "type": "folder" },
      { "value": "deploy", "type": "folder" },
      { "value": "scripts", "type": "folder" },
      { "value": "tests", "type": "folder" },
      { "value": "packages", "type": "folder" },
      { "value": ".env", "type": "file" }
    ]
  },
  "miniprogramRoot": "miniprogram/",
  "compileType": "miniprogram",
  "libVersion": "3.4.0",
  "appid": "touristappid",
  "projectname": "gaozhong-xuanke-assistant",
  "setting": {
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "urlCheck": true,
    "coverView": true,
    "lazyloadPlaceholderEnable": false,
    "preloadBackgroundData": false,
    "autoAudits": false,
    "uglifyFileName": false,
    "uploadWithSourceMap": true,
    "useCompilerPlugins": ["typescript"],
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    }
  },
  "condition": {}
}
